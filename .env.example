# ===== WebLingo の設定（すべて任意） =====
# サーバーの環境変数として設定してください（このファイルは自動では読み込まれません）。

# --- アクセス制限 ---
# 設定するとサイト全体にパスワードがかかります（Basic認証）。一般公開しない場合は設定を推奨。
APP_PASSWORD=
APP_USERNAME=weblingo

# --- AI翻訳（OpenAI） ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# サーバー全体で1日に AI翻訳へ送る最大文字数（0 で無制限。費用の上限として機能）
AI_DAILY_CHAR_LIMIT=200000

# --- 無料翻訳（MyMemory） ---
# メールアドレスを設定すると匿名上限 1日5,000文字 → 50,000文字
MYMEMORY_EMAIL=

# --- レート制限（IPアドレスごと・10分あたり、0 で無効） ---
RATE_LIMIT_EXTRACT=20
RATE_LIMIT_TRANSLATE=200
# 同時に取得するページ数の上限
MAX_CONCURRENT_FETCHES=8
